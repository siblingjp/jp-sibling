# Database
DATABASE_URL="postgresql://user:password@localhost:5432/myapp_db"

# Session (nuxt-auth-utils — ต้องยาวอย่างน้อย 32 ตัวอักษร)
NUXT_SESSION_PASSWORD="change-this-to-a-random-32-char-secret!!"

# Line
LINE_CHANNEL_ID="LINE_CHANNEL_ID"
LINE_CHANNEL_SECRET="LINE_CHANNEL_SECRET"

# Google
GG_CLIENT_ID="GG_CLIENT_ID"
GG_CLIENT_SECRET="GG_CLIENT_SECRET"

# AWS S3
S3_ACCESS_KEY="S3_ACCESS_KEY"
S3_ACCESS_SECRET="S3_ACCESS_SECRET"

# App
APP_NAME="MyApp"
NODE_ENV="development"

# Firebase
FIREBASE_PROJECT_ID=xxx
FIREBASE_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY=xxx
FIREBASE_AUTH_DOMAIN=xxx.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=xxx
FIREBASE_APP_ID=1:xxx:web:xxx
FIREBASE_VAPID_KEY=xxx   ← ได้จาก Cloud Messaging → Web configuration → Key pair

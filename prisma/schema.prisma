generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("users")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems   OrderItem[]
  optionGroups ProductOptionGroup[]

  @@map("products")
}

// ─── Option Groups ────────────────────────────────────────────────────────────

model OptionGroup {
  id          String   @id @default(cuid())
  name        String
  required    Boolean  @default(false)
  multiSelect Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options  Option[]
  products ProductOptionGroup[]

  @@map("option_groups")
}

model Option {
  id         String  @id @default(cuid())
  name       String
  extraPrice Decimal @default(0) @db.Decimal(10, 2)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  groupId String
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  orderItemOptions OrderItemOption[]

  @@map("options")
}

model ProductOptionGroup {
  sortOrder Int @default(0)

  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@id([productId, optionGroupId])
  @@map("product_option_groups")
}

// ─── Discounts (Badge) ────────────────────────────────────────────────────────

enum DiscountKind {
  PERCENT
  AMOUNT
}

model Discount {
  id        String       @id @default(cuid())
  name      String
  kind      DiscountKind
  value     Decimal      @db.Decimal(10, 2)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]

  @@map("discounts")
}

// ─── POS Orders ───────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  POS
  ONLINE
}

enum PaymentMethod {
  CASH
  CARD
  QR
}

model Order {
  id            String       @id @default(cuid())
  queueNo       Int
  source        OrderSource  @default(POS)
  status        OrderStatus  @default(PENDING)
  note          String?
  subtotal      Decimal      @db.Decimal(10, 2)
  discountKind  DiscountKind?
  discountValue Decimal?     @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  pointsEarned  Int          @default(0)
  pointsRedeemed Int         @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id])
  discountId String?
  discountBadge Discount? @relation(fields: [discountId], references: [id])

  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  note      String?

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  options OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id         String  @id @default(cuid())
  name       String
  extraPrice Decimal @db.Decimal(10, 2)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId    String
  option      Option    @relation(fields: [optionId], references: [id])

  @@map("order_item_options")
}

model Payment {
  id             String        @id @default(cuid())
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  change         Decimal       @default(0) @db.Decimal(10, 2)
  transactionRef String?
  paidAt         DateTime      @default(now())

  orderId String  @unique
  order   Order   @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ─── Members ──────────────────────────────────────────────────────────────────

enum Tier {
  SILVER
  GOLD
  VIP
}


model Member {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  lineUserId   String?  @unique
  googleId     String?  @unique
  name         String
  phone        String?
  profileImage String?
  tier         Tier     @default(SILVER)
  points       Int      @default(0)
  totalSpent   Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  pointLogs        PointLog[]
  promotionUses    PromotionUse[]
  locationRequests LocationRequest[]
  locationVotes    LocationVote[]

  @@map("members")
}


// ─── Points & Rewards ─────────────────────────────────────────────────────────

enum PointAction {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

model PointLog {
  id        String      @id @default(cuid())
  action    PointAction
  amount    Int
  note      String?
  expiredAt DateTime?
  createdAt DateTime    @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  orderId String?

  @@map("point_logs")
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  pointCost   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rewards")
}

// ─── Promotions ───────────────────────────────────────────────────────────────

model Promotion {
  id            String       @id @default(cuid())
  name          String
  description   String?
  discountKind  DiscountKind
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  uses PromotionUse[]

  @@map("promotions")
}

model PromotionUse {
  id        String   @id @default(cuid())
  usedAt    DateTime @default(now())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id])

  @@map("promotion_uses")
}

// ─── Content (Public Website) ─────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  body        String
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("articles")
}

model Campaign {
  id          String        @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  status      ContentStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("campaigns")
}

// ─── Truck Location ────────────────────────────────────────────────────────────

model TruckLocation {
  id          String   @id @default(cuid())
  name        String
  description String?
  mapUrl      String?
  openTime    String?
  closeTime   String?
  daysOfWeek  String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("truck_locations")
}

model LocationRequest {
  id          String   @id @default(cuid())
  name        String
  description String?
  voteCount   Int      @default(0)
  weekYear    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  votes LocationVote[]

  @@map("location_requests")
}

model LocationVote {
  id        String   @id @default(cuid())
  weekYear  String
  createdAt DateTime @default(now())

  requestId String
  request   LocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id])

  @@unique([requestId, memberId])
  @@unique([memberId, weekYear])
  @@map("location_votes")
}
